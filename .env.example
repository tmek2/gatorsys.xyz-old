# Add these values in your host's environment settings, or copy this file to .env
# in the repository root. Never commit the filled .env file.
# Replace dashboard.example.com with your website's public HTTPS origin.
AUTH_URL=https://dashboard.example.com
# Generate your own value: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Your Discord application's OAuth2 client ID and secret (not the bot token).
# Register https://YOUR_WEBSITE_DOMAIN/api/auth/callback/discord as an OAuth2 redirect.
# Use your actual website domain, matching AUTH_URL exactly.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# The running bot's dashboard API base URL and its matching dashboard credential.
# The bot is a separate service; this repository does not include it or a database.
# Keep API_AUTH on the server. Never put it in a NEXT_PUBLIC_ variable.
# Replace this example with the HTTPS base address of your running bot API.
PROD_API_URL=https://bot-api.example.com
API_AUTH=

# Public application ID used by the Add bot button. Usually the same as DISCORD_CLIENT_ID.
# NEXT_PUBLIC_ values are visible to visitors and are read when the app is built.
NEXT_PUBLIC_DISCORD_CLIENT_ID=

# Replace Community Dashboard with your public website name.
# Optional links: empty values open this website's /setup guide.
NEXT_PUBLIC_SITE_NAME=Community Dashboard
NEXT_PUBLIC_SUPPORT_URL=
NEXT_PUBLIC_DOCS_URL=

# Optional.  Redis enables short-lived caching; no Redis means direct API reads.
REDIS_URL=

# Optional public origin for shared links and metadata. Defaults to AUTH_URL.
# SITE also accepts legacy DASHBOARD_PUBLIC_URL or NEXTAUTH_URL; use one origin consistently.
SITE=https://dashboard.example.com

# Optional. Only set this if raw *.vercel.app deployments should redirect to your public origin.
# Leave empty to use Vercel preview deployments normally.
CANONICAL_URL=

# Compatibility: NEXTAUTH_SECRET is accepted when AUTH_SECRET is unset.
# Hosting-only values (VERCEL_URL, NEXT_RUNTIME, NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA)
# are supplied by the platform and do not need to be copied here.
# The codex/test-preview branch uses fictional data and ignores service credentials.
