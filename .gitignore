# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.idea/vcs.xml
.idea/modules.xml
.idea/misc.xml
.idea/*.iml

.vercel
.env.*
*.env
credentials.json
*.key
.credentials

# MCP config carries the dashboard API key; the example is the committed one.
.mcp.json

# Python bytecode caches. `server.py` is the source; these are rebuilt from it
# on every run, which dirtied the tree after any session that touched the tool.
__pycache__/
*.py[cod]
